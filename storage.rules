rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public READ for product catalog images (e.g. /products/...)
    // DIRECT CLIENT WRITES ARE COMPLETELY BLOCKED.
    // All image uploads, transformations, and deletions must go through
    // the Express backend using the Firebase Admin SDK.
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Public READ for store banners and branding assets
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Default: Deny all direct client access (read & write)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
