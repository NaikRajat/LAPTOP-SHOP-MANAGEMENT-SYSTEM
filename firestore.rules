rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SysTech Application Collections
    // All client operations are mediated and validated authoritatively by Express backend
    match /users/{document=**} {
      allow read, write: if true;
    }
    match /products/{document=**} {
      allow read, write: if true;
    }
    match /categories/{document=**} {
      allow read, write: if true;
    }
    match /inventory/{document=**} {
      allow read, write: if true;
    }
    match /product_images/{document=**} {
      allow read, write: if true;
    }
    match /coupons/{document=**} {
      allow read, write: if true;
    }
    match /coupon_usages/{document=**} {
      allow read, write: if true;
    }
    match /carts/{document=**} {
      allow read, write: if true;
    }
    match /cart_items/{document=**} {
      allow read, write: if true;
    }
    match /orders/{document=**} {
      allow read, write: if true;
    }
    match /order_items/{document=**} {
      allow read, write: if true;
    }
    match /payments/{document=**} {
      allow read, write: if true;
    }
    match /payment_attempts/{document=**} {
      allow read, write: if true;
    }
    match /repairs/{document=**} {
      allow read, write: if true;
    }
    match /repair_status_history/{document=**} {
      allow read, write: if true;
    }
    match /contact_inquiries/{document=**} {
      allow read, write: if true;
    }
    match /notifications/{document=**} {
      allow read, write: if true;
    }
    match /verification_sessions/{document=**} {
      allow read, write: if true;
    }
    match /audit_logs/{document=**} {
      allow read, write: if true;
    }
    match /_metadata/{document=**} {
      allow read, write: if true;
    }
    match /test/{document=**} {
      allow read, write: if true;
    }

    // Default deny for any unspecified path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

